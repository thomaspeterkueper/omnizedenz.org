---
import Basis from '../../layouts/Basis.astro';
import StatusMarke from '../../components/StatusMarke.astro';
import Rueckverweise from '../../components/Rueckverweise.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const texte = await getCollection('texte');
  return texte.map((t) => ({ params: { slug: t.slug }, props: { text: t } }));
}

const { text } = Astro.props;
const { Content } = await text.render();

// Redaktioneller Fassungsvermerk: Diese historischen Kapitel weichen in
// entscheidenden Aussagen vom gegenwärtigen relationalen Arbeitsstand ab.
const historischeFassung = new Set([
  'die-zeitlose-omnizedenz',
  'zeit-und-omnizedenz',
  'schoepfung-und-mitschoepfung',
]);
const istHistorischeFassung = historischeFassung.has(text.slug);

const symbole = await getCollection('symbole');
const verwendet = symbole.filter((s) => text.data.symbole.some((r) => r.id === s.slug));
---

<Basis title={`${text.data.title} — Omnizedenz`} description={text.data.description}>
  <section class="seitenkopf">
    <div class="column">
      <span class="eyebrow">{text.data.typ}{text.data.band ? ` · ${text.data.band}` : ''}</span>
      <h1>{text.data.title}</h1>
      {text.data.subtitle && <p class="lead">{text.data.subtitle}</p>}
      <p class="meta">
        <StatusMarke status={text.data.status} />
        {verwendet.length > 0 && (
          <span class="symbolzeile">
            {verwendet.map((s) => (
              <a href={`/symbolsprache/${s.slug}/`} title={s.data.title} data-farbe={s.data.farbe}>{s.data.zeichen}</a>
            ))}
          </span>
        )}
      </p>
    </div>
  </section>
  <hr class="rule" />

  <section class="section artikel">
    <div class="column">
      {istHistorischeFassung && (
        <div class="kasten" role="note">
          <h2>Hinweis zur Fassung</h2>
          <p>
            Dieses Kapitel dokumentiert eine frühere Phase der Omnizedenz.
            Aussagen über ein bewusstes Ganzes, kosmische Rückkehr oder die Natur
            der Zeit sind nicht durchweg die heutige philosophische Position.
            Der <a href="/philosophie/">aktuelle begriffliche Stand</a> und
            die <a href="/werkstatt/">offenen Forschungsfragen</a> unterscheiden
            bestätigte Argumente, Arbeitshypothesen und historische Bilder.
          </p>
        </div>
      )}
      <Content />
      <Rueckverweise slug={text.slug} />
      <div class="btn-row">
        <a class="btn btn--ghost" href="/bibliothek/">Zurück zur Bibliothek</a>
      </div>
    </div>
  </section>
</Basis>
