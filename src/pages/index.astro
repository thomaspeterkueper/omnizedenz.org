---
import Basis from '../layouts/Basis.astro';
import Feld from '../components/Feld.astro';
import { getCollection } from 'astro:content';

const texte = (await getCollection('texte')).sort((a, b) => a.data.order - b.data.order);
const anzahl = texte.length;

const archivEintraege = await getCollection('archiv');
const reifend = archivEintraege.filter((e) => e.data.reifegrad !== 'bereit-fuer-oeffentlich').length;

const zugaenge = [
  {
    href: '/philosophie/',
    ebene: 'Ebene I — Ontologie',
    titel: 'Die Omnizedenz',
    text: 'Was ist wirklich? Das Ganze ist kein fertiger Zustand, sondern Wirklichkeit im Werden — unterschieden in seinen Teilen, ohne in absolute Getrenntheit zu zerfallen.',
  },
  {
    href: '/resonanzethik/',
    ebene: 'Ebene II — Praxis',
    titel: 'Resonanzethik',
    text: 'Was soll ich tun? Ethisches Handeln heißt, Spielraum zu erhalten und zu erweitern — für das eigene Werden und das der anderen.',
  },
  {
    href: '/symbolsprache/',
    ebene: 'Ebene III — Sprache',
    titel: 'Symbolsprache',
    text: 'Wie lässt sich sagen, was Begriffe nicht fassen? Ein Zeichensystem, das Qualitäten verdichtet statt sie zu definieren.',
  },
];
---

<Basis
  title="Omnizedenz — Eine Philosophie des Ganzen im Werden"
  description="Omnizedenz ist eine Philosophie des Ganzen im Werden: Das Ganze entfaltet sich in wirklichen Unterschieden, ohne dass seine Teile absolut voneinander getrennt sind."
>
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <span class="eyebrow">Eine Philosophie von Thomas Peter Küper</span>
        <h1>Die Wirklichkeit ist<br />kein Ding.<br />Sie wird.</h1>
        <p class="lead">
          Die <strong>Omnizedenz</strong> verbindet <em>omni</em> — alles, das Ganze — mit
          <em>Zedenz</em>, einer bewussten Wortbildung aus <em>Transzendenz</em> ohne
          <em>trans-</em>. Sie bezeichnet das Ganze nicht als etwas jenseits der Welt,
          sondern als das, was sich in allem Wirklichen vollzieht und mit ihm wird.
          <br /><br />
          <strong>Das Ganze ist vollständig, aber nicht fertig.</strong> Was in seinen Teilen
          geschieht, geschieht dem Ganzen. Notwendig ist das Werden; offen ist seine Gestalt.
          <br /><br />
          Omnizedenz ist deshalb kein fertiges System, sondern eine Philosophie des Ganzen im Werden.
        </p>
        <div class="btn-row">
          <a class="btn" href="/philosophie/">Die Philosophie lesen</a>
          <a class="btn btn--ghost" href="/bibliothek/">Alle {anzahl} Texte durchsehen</a>
        </div>
      </div>
      <figure class="hero__figure">
        <Feld />
        <figcaption class="hero__caption">Das Feldmodell — Zeit, Resonanz, Unbestimmtheit, Verkörperung</figcaption>
      </figure>
    </div>
  </section>

  <hr class="rule" />

  <section class="section">
    <div class="wrap">
      <div class="column" style="margin-inline:0;">
        <span class="eyebrow">Drei Zugänge</span>
        <h2>Ein Gedanke, drei Ebenen</h2>
        <p class="muted">
          Das Werk baut aufeinander auf: eine Ontologie, eine daraus folgende Ethik und
          eine Sprache, in der beides erfahrbar wird. Man kann bei jeder der drei Ebenen
          anfangen.
        </p>
      </div>
    </div>
  </section>

  <div class="zugaenge">
    {zugaenge.map((z) => (
      <a class="zugang" href={z.href}>
        <span class="zugang__num">{z.ebene}</span>
        <h3>{z.titel}</h3>
        <p>{z.text}</p>
      </a>
    ))}
  </div>

  <section class="section section--tint">
    <div class="wrap">
      <div class="column" style="margin-inline:0;">
        <span class="eyebrow">Die Bibliothek</span>
        <h2>{anzahl} Texte, kurz angeteasert</h2>
      </div>
      <ul style="list-style:none; margin:2rem 0 0; padding:0; display:grid; gap:1.25rem;">
        {texte.map((t) => (
          <li>
            <a href={`/texte/${t.slug}/`} style="text-decoration:none; color:inherit;">
              <strong>{t.data.title}</strong>
              <span class="muted"> — {t.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="btn-row">
        <a class="btn btn--ghost" href="/bibliothek/">Zur vollständigen Bibliothek</a>
      </div>
      {reifend > 0 && (
        <p class="muted" style="margin-top:2rem; font-family: var(--sans); font-size:0.92rem;">
          Im privaten Archiv reifen gerade {reifend} weitere {reifend === 1 ? 'Text' : 'Texte'} —
          sie erscheinen hier, sobald sie so weit sind.
        </p>
      )}
    </div>
  </section>

  <section class="section section--tint">
    <div class="column">
      <blockquote>
        Was sich entfaltet, kreist nicht um seinen Ursprung — es hebt ihn.
        <cite>Omnizedenz — Eine Philosophie des Ganzen im Werden</cite>
      </blockquote>
    </div>
  </section>
</Basis>
